<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sportsequipment.mapper.OrderItemMapper">

    <select id="findById" resultType="OrderItem">
        SELECT * FROM order_item WHERE id = #{id}
    </select>

    <select id="findAll" resultType="OrderItem">
        SELECT * FROM order_item
    </select>

    <insert id="insert" parameterType="OrderItem">
        INSERT INTO order_item (order_id, product_id, quantity, price)
        VALUES (#{orderId}, #{productId}, #{quantity}, #{price})
    </insert>

    <update id="update" parameterType="OrderItem">
        UPDATE order_item SET
        order_id = #{orderId},
        product_id = #{productId},
        quantity = #{quantity},
        price = #{price}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM order_item WHERE id = #{id}
    </delete>

    <select id="findByOrderId" resultType="OrderItem">
        SELECT * FROM order_item WHERE order_id = #{orderId}
    </select>

</mapper>
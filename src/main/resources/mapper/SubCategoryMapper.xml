<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sportsequipment.mapper.SubCategoryMapper">

    <select id="findById" resultType="SubCategory">
        SELECT * FROM sub_category WHERE id = #{id}
    </select>

    <select id="findAll" resultType="SubCategory">
        SELECT * FROM sub_category
    </select>

    <insert id="insert" parameterType="SubCategory">
        INSERT INTO sub_category (main_category_id, name, description, created_at, updated_at)
        VALUES (#{mainCategoryId}, #{name}, #{description}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update" parameterType="SubCategory">
        UPDATE sub_category SET
        main_category_id = #{mainCategoryId},
        name = #{name},
        description = #{description},
        updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM sub_category WHERE id = #{id}
    </delete>

    <select id="findByMainCategoryId" resultType="SubCategory">
        SELECT * FROM sub_category WHERE main_category_id = #{mainCategoryId}
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 
    ==============================================================
    MyBatis Mapper XML 文件详解（小白必读）
    ==============================================================
    
    1. 根标签 <mapper> 的 namespace 属性必须与对应的Mapper接口全类名一致
       例：com.sportsequipment.mapper.ProductMapper
       
    2. SQL语句标签类型：
       - <select>    : 查询语句，返回结果
       - <insert>    : 插入语句
       - <update>    : 更新语句
       - <delete>    : 删除语句
    
    3. 参数引用方式：
       - #{参数名}   : 预编译参数（推荐，防止SQL注入）
       - ${参数名}   : 字符串替换（不推荐，有注入风险）
    
    4. 结果映射：
       - resultType  : 直接指定返回类型（简单情况）
       - resultMap   : 自定义结果映射（字段名不一致时使用）
       
    5. 命名规则：
       - XML中的id必须与Mapper接口中的方法名完全一致
       - 数据库字段名用下划线命名：third_category_id
       - Java属性用驼峰命名：thirdCategoryId
       - 配置了 map-underscore-to-camel-case=true 后会自动转换
-->

<!-- namespace必须是Mapper接口的全限定类名 -->
<mapper namespace="com.sportsequipment.mapper.ProductMapper">

    <!-- 1. 根据ID查询单个商品 -->
    <!-- 
        resultType="Product"：返回结果自动映射为Product实体类
        #{id}：引用方法参数，这里对应findById(Long id)方法的id参数
    -->
    <select id="findById" resultType="Product">
        SELECT * FROM product WHERE id = #{id}
    </select>

    <!-- 2. 查询所有商品 -->
    <!-- 返回所有商品记录，结果是List<Product> -->
    <select id="findAll" resultType="Product">
        SELECT * FROM product
    </select>

    <!-- 3. 插入新商品 -->
    <!-- 
        parameterType="Product"：参数类型是Product实体类
        #{name}：引用Product对象的name属性
        注意：数据库表字段名用下划线，Java属性用驼峰，MyBatis会自动转换
    -->
    <insert id="insert" parameterType="Product">
        INSERT INTO product (
            name,                    <!-- 商品名称 -->
            description,             <!-- 商品描述 -->
            price,                   <!-- 商品价格 -->
            stock,                   <!-- 库存数量 -->
            image_url,               <!-- 图片URL -->
            third_category_id,       <!-- 三级分类ID（品牌） -->
            created_at,              <!-- 创建时间 -->
            updated_at               <!-- 更新时间 -->
        ) VALUES (
            #{name},
            #{description},
            #{price},
            #{stock},
            #{imageUrl},             <!-- imageUrl对应Java属性，自动映射到image_url -->
            #{thirdCategoryId},      <!-- thirdCategoryId自动映射到third_category_id -->
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <!-- 4. 更新商品信息 -->
    <!-- 根据id更新商品的所有字段 -->
    <update id="update" parameterType="Product">
        UPDATE product SET
            name = #{name},
            description = #{description},
            price = #{price},
            stock = #{stock},
            image_url = #{imageUrl},
            third_category_id = #{thirdCategoryId},
            updated_at = #{updatedAt}
        WHERE id = #{id}  <!-- 必须有WHERE条件，否则会更新所有记录！ -->
    </update>

    <!-- 5. 根据ID删除商品 -->
    <!-- parameterType="Long"：参数类型是Long -->
    <delete id="deleteById" parameterType="Long">
        DELETE FROM product WHERE id = #{id}
    </delete>

    <!-- 6. 根据三级分类ID查询商品（按品牌筛选） -->
    <select id="findByThirdCategoryId" resultType="Product">
        SELECT * FROM product WHERE third_category_id = #{thirdCategoryId}
    </select>

    <!-- 7. 根据商品名称搜索（模糊匹配） -->
    <!-- 
        LIKE模糊查询：CONCAT('%', #{keyword}, '%') 表示关键词前后都匹配
        例如：搜索"篮球"会匹配"斯伯丁篮球"、"篮球训练服"等
    -->
    <select id="searchByName" resultType="Product">
        SELECT * FROM product WHERE name LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- 8. 综合搜索（名称或描述包含关键词） -->
    <!-- 使用OR连接多个条件，只要名称或描述包含关键词就匹配 -->
    <select id="search" resultType="Product">
        SELECT * FROM product 
        WHERE name LIKE CONCAT('%', #{keyword}, '%') 
           OR description LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- 9. 随机获取指定数量的商品（用于推荐功能） -->
    <!-- 
        ORDER BY RAND()：MySQL随机排序
        LIMIT #{limit}：限制返回数量
        每次调用都会返回不同的商品，实现随机推荐效果
    -->
    <select id="selectRandomProducts" resultType="Product">
        SELECT * FROM product ORDER BY RAND() LIMIT #{limit}
    </select>

</mapper>

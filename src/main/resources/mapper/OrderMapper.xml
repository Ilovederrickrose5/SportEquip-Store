
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 
    订单表 Mapper XML
    对应接口：com.sportsequipment.mapper.OrderMapper
    数据库表：order（注意：order是MySQL关键字，需要用反引号包裹）
    
    订单状态说明：
    - PENDING: 待支付
    - PAID: 已支付
    - SHIPPED: 已发货
    - COMPLETED: 已完成
    - CANCELLED: 已取消
-->
<mapper namespace="com.sportsequipment.mapper.OrderMapper">

    <!-- 
        订单结果映射（完整，包含订单项）
        collection标签用于一对多关联查询（订单 -> 订单项）
        select属性指定查询订单项的SQL
    -->
    <resultMap id="OrderResultMap" type="Order">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="shippingAddress" column="shipping_address"/>
        <result property="phone" column="phone"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="recipientName" column="recipient_name"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <!-- 关联查询订单项 -->
        <collection property="orderItems" column="id" select="findOrderItemsByOrderId"/>
    </resultMap>

    <!-- 
        订单轻量结果映射（不含订单项，用于列表页）
        列表页只需要订单基本信息，不需要订单项详情
        避免N+1查询问题，提升列表页性能
    -->
    <resultMap id="OrderLightResultMap" type="Order">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="shippingAddress" column="shipping_address"/>
        <result property="phone" column="phone"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="recipientName" column="recipient_name"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <!-- 列表页不需要订单项，避免N+1查询 -->
    </resultMap>

    <!-- 根据ID查询订单（包含订单项） -->
    <select id="findById" resultMap="OrderResultMap">
        SELECT * FROM `order` WHERE id = #{id}
    </select>

    <!-- 查询所有订单（包含订单项） -->
    <select id="findAll" resultMap="OrderResultMap">
        SELECT * FROM `order`
    </select>

    <!-- 分页查询用户订单（不含订单项，用于列表页） -->
    <select id="findByUserIdWithPagination" resultMap="OrderLightResultMap">
        SELECT * FROM `order`
        WHERE user_id = #{userId}
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 分页查询所有订单（不含订单项，用于管理员列表页） -->
    <select id="findAllWithPagination" resultMap="OrderLightResultMap">
        SELECT * FROM `order`
        <if test="status != null and status != ''">
            WHERE status = #{status}
        </if>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 统计用户订单数量 -->
    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM `order`
        WHERE user_id = #{userId}
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
    </select>

    <!-- 统计所有订单数量 -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM `order`
        <if test="status != null and status != ''">
            WHERE status = #{status}
        </if>
    </select>

    <!-- 创建新订单 -->
    <insert id="insert" parameterType="Order">
        INSERT INTO `order` (
            user_id,          <!-- 用户ID -->
            total_amount,     <!-- 总金额 -->
            status,           <!-- 订单状态 -->
            shipping_address, <!-- 收货地址 -->
            phone,            <!-- 联系电话 -->
            payment_method,   <!-- 支付方式 -->
            recipient_name,   <!-- 收货人姓名 -->
            remark,           <!-- 备注 -->
            created_at,       <!-- 创建时间 -->
            updated_at        <!-- 更新时间 -->
        ) VALUES (
            #{userId}, #{totalAmount}, #{status}, #{shippingAddress},
            #{phone}, #{paymentMethod}, #{recipientName}, #{remark},
            #{createdAt}, #{updatedAt}
        )
    </insert>

    <!-- 更新订单信息 -->
    <update id="update" parameterType="Order">
        UPDATE `order` SET
            user_id = #{userId},
            total_amount = #{totalAmount},
            status = #{status},
            shipping_address = #{shippingAddress},
            updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <!-- 根据ID删除订单 -->
    <delete id="deleteById" parameterType="Long">
        DELETE FROM `order` WHERE id = #{id}
    </delete>

    <!-- 根据用户ID查询订单列表 -->
    <select id="findByUserId" resultMap="OrderResultMap">
        SELECT * FROM `order` WHERE user_id = #{userId}
    </select>

    <!-- ============== 订单项相关（内部使用）============== -->
    
    <!-- 订单项结果映射 -->
    <resultMap id="OrderItemResultMap" type="OrderItem">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="price" column="price"/>
    </resultMap>

    <!-- 根据订单ID查询订单项（被OrderResultMap调用） -->
    <select id="findOrderItemsByOrderId" resultMap="OrderItemResultMap">
        SELECT * FROM order_item WHERE order_id = #{orderId}
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sportsequipment.mapper.CartItemMapper">

    <select id="findById" resultType="CartItem">
        SELECT * FROM cart_item WHERE id = #{id}
    </select>

    <select id="findAll" resultType="CartItem">
        SELECT * FROM cart_item
    </select>

    <insert id="insert" parameterType="CartItem">
        INSERT INTO cart_item (cart_id, product_id, quantity, created_at, updated_at)
        VALUES (#{cartId}, #{productId}, #{quantity}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update" parameterType="CartItem">
        UPDATE cart_item SET
        cart_id = #{cartId},
        product_id = #{productId},
        quantity = #{quantity},
        updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM cart_item WHERE id = #{id}
    </delete>

    <delete id="deleteByCartId" parameterType="Long">
        DELETE FROM cart_item WHERE cart_id = #{cartId}
    </delete>

    <select id="findByCartIdAndProductId" resultType="CartItem">
        SELECT * FROM cart_item WHERE cart_id = #{cartId} AND product_id = #{productId}
    </select>

    <select id="findByCartId" resultType="CartItem">
        SELECT * FROM cart_item WHERE cart_id = #{cartId}
    </select>

</mapper>